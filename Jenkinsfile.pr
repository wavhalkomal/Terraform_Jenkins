// Validation-only PR pipeline. Never deploys AWS resources.
pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        skipStagesAfterUnstable()
    }
    environment {
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }
    stages {
        stage('Checkout PR') {
            steps {
                checkout scm
            }
        }
        stage('Static Checks') {
            steps {
                sh '''
                    set -eu
                    terraform fmt -check -recursive
                    bash -n post_deployment_check.sh
                    python3 -m unittest discover -s tests -v
                '''
            }
        }
        stage('Terraform Init (No Backend)') {
            steps {
                sh 'terraform init -backend=false -input=false -lockfile=readonly -no-color'
            }
        }
        stage('Terraform Validate') {
            steps {
                sh 'terraform validate -no-color'
            }
        }
        stage('Safety Check') {
            steps {
                echo 'PR validation complete. No AWS credentials, Terraform plan, or apply executed.'
            }
        }
    }
    post {
        success { echo 'PR checks passed. Ready for review.' }
        failure { echo 'PR checks failed. Fix the branch before merge.' }
    }
}
