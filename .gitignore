# Terraform working directory and local state (sensitive)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/tfplan
**/tfplan.txt
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json

# Keep the provider dependency lockfile tracked
!**/.terraform.lock.hcl

# Python and environment files
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example
.DS_Store

# CloudLaunch local demo database
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
